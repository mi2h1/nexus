.mx_MemberListView {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;

    .mx_MemberListView_container {
        height: 100%;
    }

    .mx_MemberListView_separator {
        margin: 0;
        border: none;
        border-top: 2px solid var(--cpd-color-bg-subtle-primary);
    }

    .mx_MemberListView_sectionHeader {
        display: flex;
        align-items: flex-end;
        padding: 0 var(--cpd-space-4x) var(--cpd-space-2x);
        box-sizing: border-box;
        height: 56px;

        span {
            font: var(--cpd-font-body-xs-semibold);
            color: var(--cpd-color-text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
    }
}
